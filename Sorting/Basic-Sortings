import java.util.Arrays;
import java.util.Scanner;

public class Sorting {

    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {

        System.out.print("Enter how many numbers you want to enter: ");
        int n = sc.nextInt();

        int[] result = getNumbers(n);

        System.out.println("\nOriginal Array:");
        System.out.println(Arrays.toString(result));

        bubbleSorting(result.clone());

        selectionSorting(result.clone());

        insertionSorting(result.clone());
    }

    // ================= BUBBLE SORT =================

    public static void bubbleSorting(int[] arr){

        System.out.println("\n================ BUBBLE SORT ================\n");

        for (int i = 0; i < arr.length - 1; i++){

            System.out.println("--------------- PASS " + (i + 1) + " ---------------");

            for (int j = 0; j < arr.length - i - 1; j++){

                System.out.println(
                        "Comparing " + arr[j] + " and " + arr[j + 1]
                );

                if(arr[j] > arr[j + 1]){

                    System.out.println(
                            "Swapping " + arr[j] + " and " + arr[j + 1]
                    );

                    int temp = arr[j];

                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;

                    System.out.println(
                            "Current Array: " + Arrays.toString(arr)
                    );
                }
                else{

                    System.out.println("No Swap Needed");
                }

                System.out.println();
            }

            System.out.println(
                    "Array After Pass " + (i + 1) + ": "
                            + Arrays.toString(arr)
            );

            System.out.println();
        }

        System.out.println("Final Sorted Array:");
        System.out.println(Arrays.toString(arr));

        System.out.println("\n============================================\n");
    }

    // ================= SELECTION SORT =================

    public static void selectionSorting(int[] arr){

        System.out.println("\n================ SELECTION SORT ================\n");

        for (int i = 0; i < arr.length - 1; i++){

            int tempFront = i;

            System.out.println(
                    "--------------- PASS " + (i + 1) + " ---------------"
            );

            for (int j = i + 1; j < arr.length; j++){

                System.out.println(
                        "Comparing " + arr[j]
                                + " with current minimum "
                                + arr[tempFront]
                );

                if(arr[j] < arr[tempFront]){

                    tempFront = j;

                    System.out.println(
                            "New Minimum Found: " + arr[tempFront]
                    );
                }

                System.out.println(
                        "Current Array: " + Arrays.toString(arr)
                );

                System.out.println();
            }

            if(tempFront != i){

                System.out.println(
                        "Swapping " + arr[i]
                                + " and "
                                + arr[tempFront]
                );

                int temp = arr[tempFront];
                arr[tempFront] = arr[i];
                arr[i] = temp;
            }

            System.out.println(
                    "Array After Pass " + (i + 1) + ": "
                            + Arrays.toString(arr)
            );

            System.out.println();
        }

        System.out.println("Final Sorted Array:");
        System.out.println(Arrays.toString(arr));

        System.out.println("\n============================================\n");
    }

    // ================= INSERTION SORT =================

    public static void insertionSorting(int[] arr){

        System.out.println("\n================ INSERTION SORT ================\n");

        for(int i = 1; i < arr.length; i++) {

            int current = arr[i];
            int j = i - 1;

            System.out.println(
                    "--------------- PASS " + i + " ---------------"
            );

            System.out.println("Current Element: " + current);

            while(j >= 0 && current < arr[j]) {

                System.out.println(
                        "Since " + current
                                + " < "
                                + arr[j]
                                + ", shifting "
                                + arr[j]
                                + " to the right"
                );

                arr[j + 1] = arr[j];

                System.out.println(
                        "Current Array: "
                                + Arrays.toString(arr)
                );

                j--;
            }

            arr[j + 1] = current;

            System.out.println(
                    "Placing "
                            + current
                            + " at correct position"
            );

            System.out.println(
                    "Array After Pass " + i + ": "
                            + Arrays.toString(arr)
            );

            System.out.println();
        }

        System.out.println("Final Sorted Array:");
        System.out.println(Arrays.toString(arr));

        System.out.println("\n============================================\n");
    }

    // ================= INPUT METHOD =================

    public static int[] getNumbers(int n){

        int[] arr = new int[n];

        System.out.println("\nEnter " + n + " numbers:");

        for (int i = 0; i < n; i++){

            System.out.print("Element " + (i + 1) + ": ");

            arr[i] = sc.nextInt();
        }

        return arr;
    }
}
