import java.util.Arrays;
import java.util.Scanner;

public class MaxMinArray {
    static void main(String[] args) {
        // Determining Maximum and Minimum Element of an array //
        System.out.println("-----------------------");
        System.out.println("| MAXIMUM and MINIMUM |");
        System.out.println("-----------------------");
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the Length of array: ");
        int len = sc.nextInt();
        int[] arr = new int[len];
        for (int i=0;i<arr.length;i++)
        {
            System.out.print("Element {"+(i+1)+"}: ");
            arr[i] = sc.nextInt();
        }
        System.out.println("The provided array is: ");
        System.out.println(Arrays.toString(arr));
        int max = arr[0];
        int i=0;
        int min= arr[0];
        while(i<arr.length){

            if (max<arr[i]){
                max=arr[i];
            } else if (min>arr[i]) {
                min = arr[i];
            }
            i++;
        }
        System.out.println("The MAXIMUM element of the array is "+max);
        System.out.println("The minimum element of the array is "+min);
    }
}
