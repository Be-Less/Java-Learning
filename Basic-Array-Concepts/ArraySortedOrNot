import java.util.Scanner;

public class CheckSorting {
    static Scanner sc = new Scanner(System.in);
    public static void main(String[] args) {
        System.out.println("--------------------------");
        System.out.println("| Is The Array SORTED??? |");
        System.out.println("--------------------------");
        int arrayLen = takeInput();
        int[] arr = takeArray(arrayLen);
        boolean isItSorted = sort(arr);

//        System.out.println(isItSorted);
        if (isItSorted){
            System.out.println("Array is sorted.");
        }
        else
        {
            System.out.println("Array you Provided is not Sorted.");
        }
    }
    public static boolean sort(int[] arr){
        boolean line = false;
        int current = arr[0];

        for (int i = 1 ;i<arr.length;i++)
        {

            if(current<arr[i]){
                line = true;
                current = arr[i];
            } else if (current>arr[i]) {
                line =false;
                break;
            }
        }

        return line;
    }

    public static int[] takeArray(int n){
        int[] arr = new int[n];
        for (int i =0;i<n;i++){
            System.out.print("Element {"+(i+1)+"}: ");
            arr[i]=sc.nextInt();
        }
        return arr;
    }
    public static int takeInput(){
        System.out.print("Enter the Length of Array: ");
        return sc.nextInt();
    }
}
