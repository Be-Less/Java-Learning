public class Recursion01 {

    public static void main(String[] args) {

        int n = 7;

        // 1. Print numbers from n to 1
        System.out.println("Numbers from n to 1");
         printNum(n);

        // 2. Print sum from 1 to n
        System.out.println("sum from 1 to n");
         printSum(1, 0, n);

        // 3. Print factorial of n
        System.out.println("Factorial");
         printFacto(n, 1, 1);

        // 4. Print Fibonacci series
        System.out.println("Fibonacci series");
         int i = 0, j = 1;
         System.out.println(i);
         System.out.println(j);
         printFibo(n - 2, i, j);

        // 5. Calculate x^n
        System.out.println("Value of x power n");
         int ret = xPowNPrint(3, n);
         System.out.println(ret);

        // 6. Calculate x^n using log n recursion
        System.out.println("Same x power n using log n recursion");
         int logn = stackHeightLogn(4, n);
         System.out.println(logn);
    }

    public static void printNum(int n) {
        if (n > 0) {
            System.out.println(n);
            printNum(n - 1);
        }
    }

    public static void printSum(int i, int sum, int n) {
        if (i == n) {
            sum += i;
            System.out.println(sum);
            return;
        }

        sum += i;
        i++;

        printSum(i, sum, n);
    }

    public static void printFacto(int n, int i, int pro) {
        if (i == n) {
            pro = pro * i;
            System.out.println(pro);
            return;
        }

        pro = pro * i;
        i++;

        printFacto(n, i, pro);
    }

    public static void printFibo(int n, int i, int j) {
        if (n == 0) {
            return;
        }

        int temp = i + j;
        System.out.println(temp);

        printFibo(n - 1, j, temp);
    }

    public static int xPowNPrint(int x, int n) {
        if (n == 0) {
            return 1;
        }

        if (x == 0) {
            return 0;
        }

        int xPownm1 = xPowNPrint(x, n - 1);

        return x * xPownm1;
    }

    public static int stackHeightLogn(int x, int n) {
        if (n == 0) {
            return 1;
        }

        if (x == 0) {
            return 0;
        }

        // if n is even
        if (n % 2 == 0) {
            return stackHeightLogn(x, n / 2) *
                    stackHeightLogn(x, n / 2);
        } else {
            // if n is odd
            return stackHeightLogn(x, n / 2) *
                    stackHeightLogn(x, n / 2) *
                    x;
        }
    }
}
